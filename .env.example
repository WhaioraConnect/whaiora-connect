# ==========================================
# Whaiora Connect – Environment Variables
# Template file (.env.example)
# Copy to .env and fill with real values
# NEVER commit .env
# ==========================================

# --------------------
# Application
# --------------------
VITE_APP_NAME="Whaiora Connect"
VITE_APP_URL="http://localhost:5173"

# --------------------
# Supabase (Frontend-safe)
# ⚠️ Use ONLY the anon public key
# --------------------
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# --------------------
# Analytics
# --------------------
VITE_GA_TRACKING_ID="G-XXXXXXXXXX"

# --------------------
# Email relay (Backend / Supabase Edge Functions ONLY)
# The relay must use iCloud SMTP with an app-specific password.
# Do not prefix these with VITE_.
# --------------------
EMAIL_RELAY_URL="https://YOUR-SMTP-RELAY.example.com/send"
EMAIL_RELAY_TOKEN="YOUR_RELAY_TOKEN"

# --------------------
# Environment
# --------------------
NODE_ENV="development"

# --------------------
# Production URLs (reference only)
# --------------------
# VITE_APP_URL="https://whaioraconnect.nz"
# VITE_APP_URL="https://whaiora-connect-2jh.pages.dev"
